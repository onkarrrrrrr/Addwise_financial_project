{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/$1"
    }
  ],
  "env": {
    "DJANGO_SETTINGS_MODULE": "core.settings",
    "DEBUG": "False",
    "SECRET_KEY": "your-production-secret-key-here",
    "ALLOWED_HOSTS": "addwise-financial-project-u7oa.vercel.app",
    "DATABASE_URL": "sqlite:///db.sqlite3"
  }
}